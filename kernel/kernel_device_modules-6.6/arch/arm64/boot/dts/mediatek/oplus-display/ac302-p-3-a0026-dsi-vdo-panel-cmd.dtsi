				];
				oplus,dsi-pwm-switch-3to1pul-command = [  // 90Hz Normal(3+18pulse) to DC(1pulse)

				];
				oplus,dsi-pwm-switch-18to1pul-command = [  // 90Hz Normal(3+18pulse) to DC(1pulse)

				];

				oplus,dsi-on-command = [
